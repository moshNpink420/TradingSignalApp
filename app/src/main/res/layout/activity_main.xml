<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="TRADING SIGNAL"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="BTC/USD &amp; XAU/USD"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="12dp" />

    <!-- BTC/USD -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BTC/USD"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <TextView
        android:id="@+id/btcPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Price: --"
        android:textSize="18sp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/btcSignal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WAIT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <!-- XAU/USD -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XAU/USD (GOLD)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <TextView
        android:id="@+id/goldPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Price: --"
        android:textSize="18sp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/goldSignal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WAIT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="8dp" />

</LinearLayout>

</ScrollView>
