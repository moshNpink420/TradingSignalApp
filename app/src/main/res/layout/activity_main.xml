<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TRADING SIGNAL"
            android:textSize="26sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Market Signals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <!-- EUR/USD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EUR/USD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/eurPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/eurSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- GBP/USD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GBP/USD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/gbpPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/gbpSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- BTC/USD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BTC/USD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btcPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btcSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- GOLD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XAU/USD (GOLD)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/goldPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/goldSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- USTEC -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USTEC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/ustecPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/ustecSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- USOIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USOIL"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/usoilPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: --"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/usoilSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
